// ShadowLabzKyc.compact (Replaces KedasBrewCustomer.compact)
// Built with Midnight Network Compact 0.31.1 (pragma language_version 0.23)
// Zero-Knowledge KYC, Credential Verification, Proof-Gated DAO Entry, and Unlinkable Member Actions
// for ShadowLabz (Shadow DAOs) + XRPL X402 Payment Portal.

pragma language_version 0.23;

import CompactStandardLibrary;

export struct KycCredential {
  userPkHash: Bytes<32>;
  xrplAddressHash: Bytes<32>;
  tier: Uint<8>;
  jurisdictionCode: Uint<16>;
  isSanctioned: Boolean;
}

export ledger verifiedCustomerCount: Counter;
export ledger kycCommitments: Map<Bytes<32>, Bytes<32>>;
export ledger kycMembers: HistoricMerkleTree<16, Bytes<32>>;
export ledger verifiedNullifiers: Set<Bytes<32>>;
export ledger revokedUsers: Set<Bytes<32>>;
export sealed ledger kycAuthority: Bytes<32>;

witness authoritySecretKey(): Bytes<32>;
witness userSecretKey(): Bytes<32>;
witness getKycCredential(): KycCredential;
witness getKycSalt(): Bytes<32>;
witness getKycMerklePath(leaf: Bytes<32>): MerkleTreePath<16, Bytes<32>>;

export pure circuit deriveKycPublicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "shadowlabz:kyc:pk:v1"), sk]);
}

export pure circuit deriveKycNullifier(sk: Bytes<32>, contextId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "shadowlabz:kyc:nul:v1"),
    sk,
    contextId
  ]);
}

constructor() {
  kycAuthority = disclose(deriveKycPublicKey(authoritySecretKey()));
}

// Authority issues a privacy-preserving KYC credential commitment and inserts member into HistoricMerkleTree
export circuit issueKycCredential(userPkHash: Bytes<32>, commitment: Bytes<32>): [] {
  const caller = deriveKycPublicKey(authoritySecretKey());
  assert(disclose(caller == kycAuthority), "Not ShadowLabz KYC authority");
  assert(!revokedUsers.member(disclose(userPkHash)), "User is revoked");

  kycCommitments.insert(disclose(userPkHash), disclose(commitment));
  kycMembers.insert(disclose(userPkHash));
  verifiedCustomerCount.increment(1);
}

export circuit revokeKycUser(userPkHash: Bytes<32>): [] {
  const caller = deriveKycPublicKey(authoritySecretKey());
  assert(disclose(caller == kycAuthority), "Not ShadowLabz KYC authority");
  revokedUsers.insert(disclose(userPkHash));
}

// Selective disclosure: prove KYC tier, sanction status, jurisdiction, and XRPL wallet binding
// Discloses ONLY the boolean result — zero PII or credential values exposed on-chain.
export circuit verifySelectiveKycForXrpPayment(
  expectedXrplAddressHash: Bytes<32>,
  minTier: Uint<8>,
  blockedJurisdiction: Uint<16>
): Boolean {
  const sk = userSecretKey();
  const pkHash = deriveKycPublicKey(sk);
  const cred = getKycCredential();
  const salt = getKycSalt();

  assert(cred.userPkHash == pkHash, "Credential owner mismatch");
  assert(kycCommitments.member(disclose(pkHash)), "No KYC commitment registered");
  assert(!revokedUsers.member(disclose(pkHash)), "KYC credential revoked");

  const expected = persistentCommit<KycCredential>(cred, salt);
  const stored = kycCommitments.lookup(disclose(pkHash));
  assert(disclose(expected == stored), "Invalid KYC credential commitment");

  const passed =
    !cred.isSanctioned &&
    cred.xrplAddressHash == expectedXrplAddressHash &&
    cred.tier >= minTier &&
    cred.jurisdictionCode != blockedJurisdiction;

  return disclose(passed);
}

// Unlinkable anonymous KYC proof for joining a gated DAO, casting a secret ballot, or authorizing an X402 payment
export circuit authorizeAnonymousDaoAction(contextId: Bytes<32>): Bytes<32> {
  const sk = userSecretKey();
  const leaf = deriveKycPublicKey(sk);
  const path = getKycMerklePath(leaf);

  assert(path.leaf == leaf, "Merkle path leaf does not match caller");
  const rootDigest = merkleTreePathRoot<16, Bytes<32>>(path);
  assert(kycMembers.checkRoot(disclose(rootDigest)), "Caller not in ShadowLabz KYC Merkle tree");

  const nul = disclose(deriveKycNullifier(sk, disclose(contextId)));
  assert(!verifiedNullifiers.member(nul), "Context already authorized by this member");
  verifiedNullifiers.insert(nul);

  return nul;
}
